<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#C9A227</color>
    <color name="danger">#B3423A</color>
    <color name="ink">#2B2118</color>
    <color name="outline">#DCCFBD</color>
    <color name="paper">#FAF6EF</color>
    <color name="primary">#6B4F3B</color>
    <color name="primary_dark">#4E3828</color>
    <color name="secondary">#A67C52</color>
    <color name="success">#3F7D5A</color>
    <color name="surface">#FFFDF8</color>
    <color name="surface_variant">#F0E8DC</color>
    <color name="text_on_primary">#FFFFFF</color>
    <color name="text_secondary">#75685A</color>
    <color name="white_70">#B3FFFFFF</color>
    <color name="white_85">#D9FFFFFF</color>
    <string name="app_name">日读</string>
    <string name="channel_desc">每天提醒你今天该读哪本书</string>
    <string name="channel_name">每日阅读提醒</string>
    <string name="nav_plan">计划</string>
    <string name="nav_settings">设置</string>
    <string name="nav_today">今日</string>
    <style name="TextAppearance.Ridu.BookTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Ridu.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Ridu.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.Ridu" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Ridu.Dialog</item>
    </style>
    <style name="ThemeOverlay.Ridu.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
    </style>
</resources>